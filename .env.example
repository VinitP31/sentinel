# Copy to .env and fill in. .env is gitignored.

# Named AWS CLI profile the connector uses (created via `aws configure --profile`)
AWS_PROFILE_NAME=poc-collector

# Region for CloudTrail and Access Analyzer — must match where test activity ran
AWS_REGION=us-east-1

# Safety guard: the connector aborts if the authenticated account differs.
# Set this to your 12-digit test account ID.
EXPECTED_ACCOUNT_ID=

# How far back to look in CloudTrail Event History (max 90)
CLOUDTRAIL_LOOKBACK_DAYS=90

# Stage 10 (AI layer). This key only talks to OpenAI's API — the AI layer
# never receives AWS credentials. Never put a real key in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
